# App
APP_NAME=cloud-security-scanner
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/scanner.db

# Security
SECRET_KEY=generate-a-random-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai

# OIDC/Keycloak
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/cloud-scanner
OIDC_CLIENT_ID=cloud-scanner
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback

# Cloud credentials (optional, for scanner)
AWS_REGION=us-east-1
GCP_PROJECT=
AZURE_SUBSCRIPTION_ID=

# Frontend
VITE_API_URL=http://localhost:8000/api